# Solana Arbitrage Bot - Production Environment Variables
# Copy to .env and set values, then export or use a manager (direnv, systemd EnvironmentFile, docker env)

# RPC and WebSocket
BOT__RPC__URL="https://api.mainnet-beta.solana.com"
BOT__RPC__WS_URL="wss://api.mainnet-beta.solana.com"

# Web dashboard auth token
BOT__WEB__AUTH_TOKEN="change-me-strong-token"

# Discord
DISCORD_WEBHOOK_URL="https://discordapp.com/api/webhooks/..."
DISCORD_ENABLED="true"

# Paths
RUST_LOG="info"
RUST_LOG_STYLE="auto"

# Database
BOT__WEB__DATABASE_PATH="./data/dashboard.db"

# Risk overrides (optional)
# BOT__LIMITS__MAX_POSITION_SOL=0.05
# BOT__LIMITS__MIN_PROFIT_USD=0.05
# BOT__LIMITS__MAX_DAILY_LOSS_USD=10.0
# BOT__LIMITS__MAX_DAILY_TRADES=50

